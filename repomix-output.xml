        </div>

        <div className="flex items-center gap-2 bg-[#0B1B15]/90 border border-[#1A332A] rounded-lg px-3 py-1.5 backdrop-blur-md shadow-lg">
          <span className="text-[10px] font-mono uppercase text-emerald-400">Region</span>
          <select
