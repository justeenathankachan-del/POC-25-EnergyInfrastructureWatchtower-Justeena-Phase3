            ),
            "evidence": [
                {"factor": "plant_count", "value": int(row["plant_count"]), "unit": "plants"},
                {"factor": "median_capacity_mw", "value": float(row["median_capacity_mw"]), "unit": "MW"},
                {"factor": "capacity_share_pct", "value": float(row["capacity_share_pct"]), "unit": "percent"},
