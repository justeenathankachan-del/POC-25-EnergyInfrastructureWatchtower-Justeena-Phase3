{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Phase 3 Post #3 — Analytical Track Development & Validation\n",
    "**Project:** POC-25 Energy Infrastructure Watchtower  \n",
    "**Approved Track:** Track A — Comparative Intelligence (`method_version: 1.0.0`, `data_version: 1.0.1`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json, sys\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "ROOT = Path('..').resolve() if Path.cwd().name == 'notebooks' else Path('.').resolve()\n",
    "if (ROOT / 'data-science').exists() is False and (ROOT.parent / 'data').exists():\n",
    "    ROOT = ROOT.parent\n",
    "sys.path.insert(0, str(ROOT / 'data-science' / 'scripts'))\n",
    "from track_specific_loader import load_track_module\n",
    "\n",
    "df = pd.read_csv(ROOT / 'data' / 'canonical' / 'intelligence_data.csv')\n",
    "print(f'Canonical dataset: {len(df)} rows x {len(df.columns)} cols | data_version={df[\"data_version\"].iloc[0]}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "mod = load_track_module()\n",
    "baseline = mod.compute_baseline(df)\n",
    "print('Baseline:', baseline['baseline_name'])\n",
    "pd.DataFrame(baseline['categories']).head(5)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "comp = mod.compute_comparative_intelligence(df)\n",
    "print('=== Global Plant Capacity by Region (MW) ===')\n",
    "display(pd.DataFrame(comp['global_entity_summary']['by_region']))\n",
    "print('=== U.S. 2024 Net Generation Benchmark by Fuel (thousand_MWh) ===')\n",
    "display(pd.DataFrame(comp['us_generation_summary']['by_fuel_2024_benchmark']))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "metrics = json.loads((ROOT / 'data-science' / 'outputs' / 'validation_metrics.json').read_text(encoding='utf-8'))\n",
    "print('Validation Status:', metrics['status'])\n",
    "print(json.dumps(metrics['independent_recalculation'], indent=2))"
   ]
  }
